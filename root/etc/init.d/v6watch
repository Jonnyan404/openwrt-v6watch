#!/bin/sh /etc/rc.common
# v6watch - IPv6 出口自愈与诊断
# procd 托管的守护进程；崩溃会被自动拉起，状态在 LuCI「系统 - 启动项」可见。

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/v6watch --daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger v6watch
}
